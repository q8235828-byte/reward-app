# ==========================
# Application
# ==========================
NODE_ENV=development
PORT=3000

# ==========================
# Database (Hostinger MySQL/MariaDB)
# Get these values from hPanel -> Databases -> MySQL Databases
# ==========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ==========================
# Authentication
# JWT_SECRET must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================
JWT_SECRET=
SESSION_DAYS=7
APP_URL=http://localhost:3000

# ==========================
# Password reset
# ==========================
RESET_TOKEN_EXPIRY_MINUTES=60

# ==========================
# Outgoing email (Hostinger email hosting / SMTP)
# Used for password reset links. If left unset, reset links are logged to
# the console instead of emailed - fine for local development only.
# ==========================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@yourdomain.com

# ==========================
# Daily Reward Cron
# Used to authenticate Hostinger Cron -> /api/internal/jobs/process-daily-rewards
# (Authorization: Bearer <CRON_SECRET>). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================
CRON_SECRET=

# ==========================
# JazzCash - manual verification account (shown to users as payment
# instructions; admin still verifies every deposit by hand)
# ==========================
JAZZCASH_ACCOUNT_TITLE=
JAZZCASH_ACCOUNT_NUMBER=

# JazzCash official merchant API (only needed if/when that integration is
# added later - unused while manual verification is in effect)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

# ==========================
# Easypaisa - manual verification account (shown to users as payment
# instructions; admin still verifies every deposit by hand)
# ==========================
EASYPAISA_ACCOUNT_TITLE=
EASYPAISA_ACCOUNT_NUMBER=

# Easypaisa official merchant API (only needed if/when that integration is
# added later - unused while manual verification is in effect)
# EASYPAISA_MERCHANT_ID=
# EASYPAISA_API_KEY=
# EASYPAISA_SECRET=
