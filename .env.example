# ==========================
# Application
# ==========================
NODE_ENV=development
PORT=3000

# ==========================
# Database (Hostinger MySQL/MariaDB)
# Get these values from hPanel -> Databases -> MySQL Databases
# ==========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ==========================
# Authentication
# JWT_SECRET must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================
JWT_SECRET=
SESSION_DAYS=7
APP_URL=http://localhost:3000

# ==========================
# Admin bootstrap
# Whoever registers with this phone number (or already has) is granted
# SUPER_ADMIN automatically - checked on every server start, and at
# registration time. Format: 03XXXXXXXXX. Leave unset to skip - admin
# access is then only grantable via a manual SQL UPDATE (see README).
# ==========================
# ADMIN_PHONE=

# ==========================
# Password reset
# ==========================
RESET_TOKEN_EXPIRY_MINUTES=60

# ==========================
# Outgoing email (Hostinger email hosting / SMTP)
# Not used for login/registration (phone-based) or password reset (SMS-based,
# see below) - only for the admin panel's "send test email" button. Safe to
# leave unset.
# ==========================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@yourdomain.com

# ==========================
# SMS gateway (used to deliver password-reset links, since accounts are
# identified by phone number, not email)
# No specific provider is integrated - pick one (Twilio, a local
# Pakistani SMS gateway, etc.) and adjust backend/src/services/sms.service.js
# to match its exact request format if this generic shape doesn't fit.
# Left unset, reset links are logged to the server console instead of sent -
# fine for development, not for real users.
# ==========================
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=

# ==========================
# Daily Reward Cron
# Used to authenticate Hostinger Cron -> /api/internal/jobs/process-daily-rewards
# (Authorization: Bearer <CRON_SECRET>). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==========================
CRON_SECRET=

# ==========================
# JazzCash - manual verification account (shown to users as payment
# instructions; admin still verifies every deposit by hand)
# ==========================
JAZZCASH_ACCOUNT_TITLE=
JAZZCASH_ACCOUNT_NUMBER=

# JazzCash official merchant API (only needed if/when that integration is
# added later - unused while manual verification is in effect)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

# ==========================
# Easypaisa - manual verification account (shown to users as payment
# instructions; admin still verifies every deposit by hand)
# ==========================
EASYPAISA_ACCOUNT_TITLE=
EASYPAISA_ACCOUNT_NUMBER=

# Easypaisa official merchant API (only needed if/when that integration is
# added later - unused while manual verification is in effect)
# EASYPAISA_MERCHANT_ID=
# EASYPAISA_API_KEY=
# EASYPAISA_SECRET=
